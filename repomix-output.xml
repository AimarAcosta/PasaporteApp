package com.dam.pasaporteapp.repository

import com.dam.pasaporteapp.model.Pais
import com.dam.pasaporteapp.network.RetrofitHelper
import kotlinx.coroutines.Dispatchers
import kotlinx.coroutines.withContext
import retrofit2.HttpException
import java.io.IOException
import com.dam.pasaporteapp.model.CountryDetailResponse
import android.content.Context
import androidx.room.withTransaction
import com.dam.pasaporteapp.database.PaisVisitado
import com.dam.pasaporteapp.database.PasaporteDatabase
import kotlinx.coroutines.flow.Flow

class CountryRepository(contexto: Context) {

    private val baseDeDatos = PasaporteDatabase.obtenerInstancia(contexto)
    private val paisVisitadoDao = baseDeDatos.paisVisitadoDao()

    private var codigosVisitados: Set<String> = emptySet()

    suspend fun getAllCountries(): List<Pais> = withContext(Dispatchers.IO) {
        val respuesta = RetrofitHelper.apiService.getAllCountries()

        if (!respuesta.isSuccessful) {
            throw HttpException(respuesta)
        }

        val paises = respuesta.body()
            ?: throw IOException("La respuesta no contiene países")

        paises.map { country ->
            Pais(
                codigo = country.alpha2Code,
                nombre = country.name,
                capital = country.capital,
                region = country.region,
                urlBandera = country.flags?.png
            )
        }.sortedBy { it.nombre.lowercase() }
    }

    suspend fun getCountryByCode(codigo: String): CountryDetailResponse =
        withContext(Dispatchers.IO) {
            RetrofitHelper.apiService.getCountryByCode(codigo)
        }

    suspend fun estaVisitado(codigo: String): Boolean {
        return paisVisitadoDao.buscarPorCodigo(codigo) != null
    }

    suspend fun cambiarEstadoVisita(
        codigo: String,
        pais: CountryDetailResponse
    ): Boolean = baseDeDatos.withTransaction {
        val guardado = paisVisitadoDao.buscarPorCodigo(codigo)

        if (guardado == null) {
            paisVisitadoDao.insertar(pais.toEntity(codigo))
            true
        } else {
            paisVisitadoDao.eliminar(guardado)
            false
        }
    }

    private fun CountryDetailResponse.toEntity(codigo: String): PaisVisitado {
        return PaisVisitado(
            code = codigo,
            name = name,
            capital = capital.orEmpty(),
            region = region.orEmpty(),
            flagUrl = flags?.png.orEmpty()
        )
    }

    fun observarVisitados(): Flow<List<PaisVisitado>> {
        return paisVisitadoDao.observarVisitados()
    }

    suspend fun guardarNota(pais: PaisVisitado, nota: String) {
        paisVisitadoDao.actualizar(pais.copy(note = nota.trim()))
    }

    suspend fun eliminarVisitado(pais: PaisVisitado) {
        paisVisitadoDao.eliminar(pais)
    }

    fun observarCodigosVisitados(): Flow<List<String>> {
        return paisVisitadoDao.observarCodigosVisitados()
    }
}
</file>

<file path="app/src/main/java/com/dam/pasaporteapp/MainActivity.kt">
package com.dam.pasaporteapp

import android.os.Bundle
import android.util.Log
import android.view.View
import android.widget.Toast
import androidx.appcompat.app.AppCompatActivity
import androidx.core.view.ViewCompat
import androidx.core.view.WindowInsetsCompat
import androidx.lifecycle.lifecycleScope
import androidx.recyclerview.widget.GridLayoutManager
import com.dam.pasaporteapp.adapter.PaisAdapter
import com.dam.pasaporteapp.databinding.ActivityMainBinding
import com.dam.pasaporteapp.repository.CountryRepository
import kotlinx.coroutines.CancellationException
import kotlinx.coroutines.launch
import androidx.appcompat.widget.SearchView
import com.dam.pasaporteapp.model.Pais
import android.content.Intent
import com.dam.pasaporteapp.ui.DetallePaisActivity
import com.dam.pasaporteapp.ui.PasaporteActivity
import androidx.lifecycle.Lifecycle
import androidx.lifecycle.repeatOnLifecycle
import kotlinx.coroutines.flow.collect

class MainActivity : AppCompatActivity() {

    private lateinit var binding: ActivityMainBinding
    private lateinit var paisAdapter: PaisAdapter
    private val countryRepository by lazy { CountryRepository(applicationContext) }

    private var todosLosPaises: List<Pais>? = null

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)

        binding = ActivityMainBinding.inflate(layoutInflater)
        setContentView(binding.root)

        ViewCompat.setOnApplyWindowInsetsListener(binding.root) { vista, insets ->
            val barras = insets.getInsets(WindowInsetsCompat.Type.systemBars())
            vista.setPadding(barras.left, barras.top, barras.right, barras.bottom)
            insets
        }

        binding.tvTitulo.setText(R.string.titulo_lista_paises)

        initListeners()
        initRecyclerView()
        observarVisitados()
        initFiltros()
        cargarPaises()
    }

    private fun initListeners() {
        binding.btnInicio.setOnClickListener {
            Toast.makeText(this, R.string.nav_inicio, Toast.LENGTH_SHORT).show()
        }

        binding.btnPasaporte.setOnClickListener {
            startActivity(Intent(this, PasaporteActivity::class.java))
        }

        binding.btnQuiz.setOnClickListener {
            Toast.makeText(this, R.string.nav_quiz, Toast.LENGTH_SHORT).show()
        }

        binding.btnAjustes.setOnClickListener {
            Toast.makeText(this, R.string.nav_ajustes, Toast.LENGTH_SHORT).show()
        }
    }

    private fun initRecyclerView() {
        paisAdapter = PaisAdapter { pais ->
            val intent = Intent(this, DetallePaisActivity::class.java)
                .putExtra(DetallePaisActivity.EXTRA_CODE, pais.codigo)

            startActivity(intent)
        }

        binding.rvPaises.layoutManager = GridLayoutManager(this, 2)
        binding.rvPaises.adapter = paisAdapter
    }

    private fun initFiltros() {
        binding.searchPaises.setOnQueryTextListener(
            object : SearchView.OnQueryTextListener {

                override fun onQueryTextChange(newText: String?): Boolean {
                    aplicarFiltros()
                    return true
                }

                override fun onQueryTextSubmit(query: String?): Boolean {
                    binding.searchPaises.clearFocus()
                    return true
                }
            }
        )

        binding.chipGroupRegiones.setOnCheckedStateChangeListener { _, _ ->
            aplicarFiltros()
        }
    }

    private fun aplicarFiltros() {
        val paises = todosLosPaises ?: return
        val busqueda = binding.searchPaises.query.toString().trim()

        val regionSeleccionada = when (binding.chipGroupRegiones.checkedChipId) {
            R.id.chipAfrica -> getString(R.string.region_africa)
            R.id.chipAmericas -> getString(R.string.region_americas)
            R.id.chipAsia -> getString(R.string.region_asia)
            R.id.chipEurope -> getString(R.string.region_europe)
            R.id.chipOceania -> getString(R.string.region_oceania)
            else -> null
        }

        val paisesFiltrados = paises.filter { pais ->
            val coincideNombre = pais.nombre.contains(busqueda, ignoreCase = true)
            val coincideRegion = regionSeleccionada == null ||
                    pais.region == regionSeleccionada

            coincideNombre && coincideRegion
        }

        paisAdapter.actualizarPaises(paisesFiltrados)

        if (paisesFiltrados.isEmpty()) {
            Toast.makeText(this, R.string.sin_resultados_paises, Toast.LENGTH_SHORT).show()
        }
    }

    private fun observarVisitados() {
        lifecycleScope.launch {
            repeatOnLifecycle(Lifecycle.State.STARTED) {
                countryRepository.observarCodigosVisitados().collect { codigos ->
                    paisAdapter.actualizarVisitados(codigos.toSet())
                }
            }
        }
    }

    private fun cargarPaises() {
        binding.progressPaises.visibility = View.VISIBLE

        lifecycleScope.launch {
            try {
                todosLosPaises = countryRepository.getAllCountries()
                aplicarFiltros()
            } catch (error: CancellationException) {
                throw error
            } catch (error: Exception) {
                Log.e("PasaporteApp", "Error al cargar los países", error)
                Toast.makeText(
                    this@MainActivity,
                    R.string.error_loading_countries,
                    Toast.LENGTH_LONG
                ).show()
            } finally {
                binding.progressPaises.visibility = View.GONE
            }
        }
    }
}
